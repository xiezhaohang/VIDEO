{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home_commerce_director_v1_experimental/strategy_scoring_schema.json",
  "title": "Home Commerce Director v1 Experimental Decision Output",
  "description": "Experimental, category-free narrative strategy scoring and decision contract. Hard gates are evaluated independently and always take precedence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "hard_gate_result",
    "strategy_scores",
    "primary_strategy",
    "secondary_strategy",
    "confidence",
    "evidence",
    "hook_hypothesis",
    "required_proof",
    "information_state_plan",
    "hero_strategy",
    "cta_strategy",
    "fallback_strategy"
  ],
  "properties": {
    "version": {
      "const": "home_commerce_director_v1_experimental"
    },
    "status": {
      "const": "experimental"
    },
    "hard_gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"enum": ["pass", "fail", "insufficient_evidence"]},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_integrity",
            "proof_ownership",
            "no_fabricated_claims",
            "readability",
            "no_loop_or_repeated_motion",
            "duration_budget"
          ],
          "properties": {
            "action_integrity": {"$ref": "#/$defs/gateCheck"},
            "proof_ownership": {"$ref": "#/$defs/gateCheck"},
            "no_fabricated_claims": {"$ref": "#/$defs/gateCheck"},
            "readability": {"$ref": "#/$defs/gateCheck"},
            "no_loop_or_repeated_motion": {"$ref": "#/$defs/gateCheck"},
            "duration_budget": {"$ref": "#/$defs/gateCheck"}
          }
        }
      }
    },
    "strategy_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof", "information", "emotion", "visual_appeal"],
      "properties": {
        "proof": {"$ref": "#/$defs/dimensionScore"},
        "information": {"$ref": "#/$defs/dimensionScore"},
        "emotion": {"$ref": "#/$defs/dimensionScore"},
        "visual_appeal": {"$ref": "#/$defs/dimensionScore"}
      }
    },
    "primary_strategy": {"$ref": "#/$defs/strategy"},
    "secondary_strategy": {
      "oneOf": [
        {"$ref": "#/$defs/strategy"},
        {"type": "null"}
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in this strategy choice for the supplied material, not confidence in product truth or expected conversion."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "observation", "supports"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["proof", "information", "emotion", "visual_appeal", "hard_gate", "fallback"]}
          }
        }
      }
    },
    "hook_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purchase_meaning", "visual_state", "why_first", "test_variants"],
      "properties": {
        "purchase_meaning": {"type": "string", "minLength": 1},
        "visual_state": {"type": "string", "minLength": 1},
        "why_first": {"type": "string", "minLength": 1},
        "test_variants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_proof": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "owner", "chain", "minimum_hold_rule", "support_status"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "chain": {
            "type": "array",
            "minItems": 4,
            "prefixItems": [
              {"const": "claim"},
              {"const": "action"},
              {"const": "result"},
              {"const": "confirmation"}
            ],
            "items": false
          },
          "minimum_hold_rule": {"type": "string", "minLength": 1},
          "support_status": {"enum": ["direct", "indirect", "unsupported"]},
          "material_gap": {"type": ["string", "null"]}
        }
      }
    },
    "information_state_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "new_meaning", "visual_evidence", "voice_or_caption_job", "enter_when", "exit_when"],
        "properties": {
          "state": {"type": "string", "minLength": 1},
          "new_meaning": {"type": "string", "minLength": 1},
          "visual_evidence": {"type": "string", "minLength": 1},
          "voice_or_caption_job": {"type": "string"},
          "enter_when": {"type": "string", "minLength": 1},
          "exit_when": {"type": "string", "minLength": 1}
        }
      }
    },
    "hero_strategy": {"type": "string", "minLength": 1},
    "cta_strategy": {"type": "string", "minLength": 1},
    "fallback_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "action", "claims_removed_or_weakened", "reshoot_needs"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "claims_removed_or_weakened": {"type": "array", "items": {"type": "string"}},
        "reshoot_needs": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "strategy": {
      "enum": ["proof_led", "information_led", "emotion_led", "visual_led"]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dimensionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demand_score", "support_score", "effective_score", "evidence", "gaps"],
      "properties": {
        "demand_score": {"$ref": "#/$defs/score"},
        "support_score": {"$ref": "#/$defs/score"},
        "effective_score": {"$ref": "#/$defs/score"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "gateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "fail", "insufficient_evidence", "not_applicable"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
